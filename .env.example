# ===================================================================
# SMTP Server Settings
# ===================================================================
# Gmail / Google Workspace: smtp.gmail.com (Port 465 SSL or 587 TLS)
# Outlook / Office365:      smtp.office365.com (Port 587 TLS)
# Yahoo:                    smtp.mail.yahoo.com (Port 465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ===================================================================
# Sender Credentials
# ===================================================================
# Your full email address
EMAIL_ADDRESS=your.name@gmail.com

# For Gmail/Workspace, NEVER use your regular account password!
# Generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_16_digit_app_password

# ===================================================================
# Campaign Execution Mode
# ===================================================================
# Options: dry-run | test | live
# - dry-run: Preview personalized emails in console without sending anything (safe default)
# - test:    Sends a single test email directly to TEST_EMAIL_ADDRESS
# - live:    Sends real emails to recipients in your DATA_FILE
MODE=dry-run

# Email address to receive diagnostic test email when MODE=test
TEST_EMAIL_ADDRESS=your.personal@email.com

# ===================================================================
# Data & Attachments
# ===================================================================
# Path to your CSV or Excel file containing contacts
DATA_FILE=data/example_leads.csv

# Optional attachment path (e.g. resume.pdf, portfolio.pdf, or pitch_deck.pdf)
# Leave empty if no attachment is needed
ATTACHMENT_PATH=

# ===================================================================
# Safety & Limits
# ===================================================================
# Maximum unique companies to contact in a single run
MAX_COMPANIES_LIMIT=50

# Keep only the first contact per company to prevent multi-emailing the same org
EMAIL_ONLY_FIRST_CONTACT=True
LIMIT_BY_UNIQUE_COMPANIES=True

# Anti-spam delay between emails in seconds (recommended: 5 to 20 seconds)
DELAY_BETWEEN_EMAILS_MIN=5
DELAY_BETWEEN_EMAILS_MAX=15

# Batch pausing settings (takes human-like break after N emails)
BATCH_SIZE=50
PAUSE_AFTER_BATCH_MIN_MINUTES=10
PAUSE_AFTER_BATCH_MAX_MINUTES=20

# Allowed business hours for sending (24h format, local machine time)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
